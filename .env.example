# =====================================================================
# BrandShield AI — Environment Configuration
# CodeNova India 2026 | Production Stack
# =====================================================================

# 1. AI Gateway (Required for Gemini 2.0 Flash & Vector Embeddings)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Groq or OpenAI fallback
GROQ_API_KEY=
OPENAI_API_KEY=

# 2. Database (Required for Production PostgreSQL 16 + pgvector)
# Create a free project at https://supabase.com/ -> Project Settings -> Database -> Connection string (URI)
# e.g.: postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres
DATABASE_URL=

# 3. Cache & Jobs (Redis 7)
# Use a free cloud Redis from https://upstash.com/ or local redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# 4. Security & Authentication
JWT_SECRET=brandshield-codenova-super-secret-key-2026
JWT_ALGORITHM=HS256

# 5. Frontend API Configuration (for apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
